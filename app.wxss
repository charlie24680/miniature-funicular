page {
  background: #f6f6fa;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: "PingFang SC", "Microsoft YaHei", -apple-system, sans-serif;
  --bg: #f6f6fa;
  --surface: #ffffff;
  --surface-soft: #faf7fb;
  --text: #1f2937;
  --muted: #64748b;
  --line: #ebe7ef;
  --primary: #be185d;
  --primary-2: #ec4899;
  --success: #16a34a;
  --danger: #dc2626;
}

view, text, image, input, textarea, button, scroll-view, swiper, swiper-item { box-sizing: border-box; }

.container { padding: 24rpx; }
.has-fab { padding-bottom: 168rpx; }

.card {
  background: var(--surface);
  border-radius: 22rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(31, 41, 55, 0.06);
  box-shadow: 0 12rpx 30rpx rgba(190, 24, 93, 0.06);
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 14rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text);
}

.page-header,
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.page-header {
  margin-bottom: 20rpx;
}

.page-header .page-title,
.section-head .section-title {
  margin-bottom: 0;
}

.subtitle {
  color: var(--muted);
  font-size: 24rpx;
}

.btn-primary-sm, .btn-primary {
  border: none;
  border-radius: 14rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-2));
  color: #fff;
}

.btn-primary-sm::after, .btn-primary::after { border: none; }

.btn-primary-sm { padding: 12rpx 22rpx; font-size: 24rpx; }
.btn-primary { padding: 22rpx 0; }

.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.tag-qimeng { background: #fdf2f8; color: #be185d; }
.tag-tigao { background: #eff6ff; color: #1d4ed8; }
.tag-techan { background: #ecfdf3; color: #166534; }

.list-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.list-item:last-child { border-bottom: none; }

.stats-row { display: flex; align-items: center; justify-content: space-between; }
.stat-item { flex: 1; text-align: center; }
.stat-num { display: block; font-size: 40rpx; font-weight: 800; }
.stat-label { display: block; margin-top: 4rpx; font-size: 22rpx; color: rgba(255,255,255,0.85); }

.form-group {
  margin-bottom: 20rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text);
}

.form-required::before {
  content: '* ';
  color: var(--danger);
}

.form-input,
.form-textarea,
.form-picker {
  width: 100%;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  background: #fff;
  color: var(--text);
}

.form-input {
  min-height: 84rpx;
  padding: 0 22rpx;
}

.form-textarea {
  min-height: 140rpx;
  padding: 18rpx 22rpx;
  line-height: 1.6;
}

.form-picker {
  min-height: 84rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.form-picker-arrow {
  flex-shrink: 0;
  color: #94a3b8;
  font-size: 22rpx;
}

.form-picker-placeholder {
  color: #94a3b8;
}

.seg-tabs {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx;
  margin-bottom: 20rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid rgba(31, 41, 55, 0.06);
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.04);
  overflow-x: auto;
  white-space: nowrap;
}

.seg-tab {
  flex-shrink: 0;
  min-width: 132rpx;
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  background: #f8f7fb;
}

.seg-tab.active {
  background: linear-gradient(135deg, var(--primary), var(--primary-2));
  color: #fff;
  font-weight: 700;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 96rpx 32rpx;
  margin-bottom: 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx dashed #ead8e2;
  color: #94a3b8;
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
  line-height: 1;
}

.fab {
  position: fixed;
  right: 28rpx;
  bottom: 144rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-2));
  box-shadow: 0 18rpx 34rpx rgba(190, 24, 93, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.fab-icon {
  color: #fff;
  font-size: 50rpx;
  font-weight: 400;
  line-height: 1;
}
